# =================================
# KURAA GALAAN CHARITY BACKEND
# Environment Configuration
# =================================

# Server Configuration
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=https://kuraa-galaan-website.vercel.app

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kuraagalaan_charity
DB_USER=root
DB_PASSWORD=your_database_password
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_random
JWT_EXPIRE=30d

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kuraagalaancharity@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_EMAIL=kuraagalaancharity@gmail.com

# Chapa Payment Configuration (Ethiopian Birr)
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret

# Stripe Payment Configuration (International)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Telebirr Payment Configuration (Ethiopian Mobile)
TELEBIRR_BASE_URL=https://api.telebirr.et/v1
TELEBIRR_MERCHANT_ID=your_telebirr_merchant_id
TELEBIRR_SECRET_KEY=your_telebirr_secret_key
TELEBIRR_APP_ID=your_telebirr_app_id

# Security Configuration
REQUIRE_EMAIL_VERIFICATION=true
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# External Services (Optional)
PAPERTRAIL_HOST=your_papertrail_host
PAPERTRAIL_PORT=your_papertrail_port

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=300000
PERFORMANCE_MONITORING=true

# =================================
# PRODUCTION NOTES:
# =================================
# 1. Change NODE_ENV to 'production'
# 2. Use strong, unique passwords and secrets
# 3. Enable SSL for database connections
# 4. Configure proper SMTP credentials
# 5. Set up payment gateway accounts
# 6. Configure monitoring services
# 7. Set up automated backups
# 8. Use environment-specific URLs
# =================================
